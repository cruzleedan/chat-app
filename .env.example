# Docker Compose Environment Variables
# RAG Q&A Application Configuration

# API Configuration
VITE_API_BASE_URL=http://rag-backend:8000/api

# Documentation URL for frontend and MkDocs site URL
VITE_DOCS_URL=http://rag-docs

# Ollama Configuration  
OLLAMA_HOST=http://rag-ollama:11434
LLM_MODEL=llama3.2
EMBEDDING_MODEL=nomic-embed-text

# LLM Response Configuration (controls response length and quality)
LLM_TEMPERATURE=0.7
LLM_NUM_PREDICT=2048
LLM_TOP_K=40
LLM_TOP_P=0.9

# Example configurations for different deployment scenarios:

# Local Development:
# VITE_API_BASE_URL=http://localhost:8000/api
# VITE_DOCS_URL=http://localhost:8080
# OLLAMA_HOST=http://localhost:11434

# Homelab with Caddy (replace yourdomain.com with your actual domain):
# VITE_API_BASE_URL=https://yourdomain.com/api
# VITE_DOCS_URL=https://yourdomain.com/docs
# OLLAMA_HOST=http://rag-ollama:11434