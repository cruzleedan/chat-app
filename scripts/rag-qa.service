[Unit]
Description=RAG Document Q&A Application
Documentation=https://github.com/yourusername/rag-research
After=docker.service ollama.service
Requires=docker.service
Wants=ollama.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/rag-qa
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose restart
TimeoutStartSec=300

# Ensure Ollama is running before starting
ExecStartPre=/bin/bash -c 'systemctl is-active --quiet ollama || systemctl start ollama'
# Wait for Ollama to be ready
ExecStartPre=/bin/bash -c 'for i in {1..30}; do curl -s http://localhost:11434/api/tags > /dev/null && break || sleep 2; done'

[Install]
WantedBy=multi-user.target
